# Copy to .env.local and fill in. On Vercel, set these under
# Settings -> Environment Variables instead.
#
# NEXT_PUBLIC_* values are baked in at build time, so they must exist BEFORE
# the build. Adding one afterwards needs a redeploy to take effect.

# Get the key from https://dashboard.newton.xyz -> API Keys.
# Server-side only — the app never sends it to the browser.
NEWTON_API_KEY=

# --- PolicyClients -----------------------------------------------------------
# A PolicyClient binds exactly ONE policy, so each submittable provider needs
# its own. Point two providers at the same client and Submit returns whichever
# policy that client has bound, attributed to whichever provider is on screen.
#
# Leave one unset and Submit refuses for that provider, which is the honest
# outcome — better than borrowing another provider's client and mislabelling
# the result.
POLICY_CLIENT=
POLICY_CLIENT_YENTE=
POLICY_CLIENT_DENYLIST=

# Shown in the UI, so it must be public.
NEXT_PUBLIC_POLICY_CLIENT=

# --- Oracle ------------------------------------------------------------------
# The deployed PolicyData contract for the OpenSanctions provider.
NEXT_PUBLIC_YENTE_POLICY_DATA=

# Where operators reach the screening API. Server-side: the endpoint travels in
# wasmArgs, not in the browser bundle.
#
# If this is wrong or unreachable, the policy fails closed and denies
# everything — including clean addresses. That reads as working sanctions
# screening, so verify a KNOWN CLEAN address after changing it, not just a
# sanctioned one.
YENTE_URL=
YENTE_DATASET=sanctions

# Optional. Defaults to a public Sepolia endpoint if unset.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
